<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for presentation code that doesn't need Godot: the files are linked in, not referenced,
       because the game project itself only builds with the Godot SDK. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>StickFighter.Presentation.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../game/CameraMath.cs" Link="Linked/CameraMath.cs" />
    <Compile Include="../../game/DrawnBounds.cs" Link="Linked/DrawnBounds.cs" />
    <Compile Include="../../game/net/UdpLink.cs" Link="Linked/UdpLink.cs" />
    <Compile Include="../../game/fx/EffectLedger.cs" Link="Linked/EffectLedger.cs" />
    <Compile Include="../../game/ui/Notation.cs" Link="Linked/Notation.cs" />
    <Compile Include="../../game/training/InputLog.cs" Link="Linked/InputLog.cs" />
    <Compile Include="../../game/training/InputDemo.cs" Link="Linked/InputDemo.cs" />
    <Compile Include="../../game/training/FrameDataAnalyser.cs" Link="Linked/FrameDataAnalyser.cs" />
    <Compile Include="../../game/training/TrainingSession.cs" Link="Linked/TrainingSession.cs" />
    <Compile Include="../../game/ui/HudModel.cs" Link="Linked/HudModel.cs" />
    <Compile Include="../../game/ui/MatchHud.cs" Link="Linked/MatchHud.cs" />
    <Compile Include="../../game/ui/HealthTrail.cs" Link="Linked/HealthTrail.cs" />
    <Compile Include="../../game/ui/Announcer.cs" Link="Linked/Announcer.cs" />
    <Compile Include="../../game/ui/RoundLog.cs" Link="Linked/RoundLog.cs" />
    <Compile Include="../../game/flow/Triggerable.cs" Link="Linked/Triggerable.cs" />
    <Compile Include="../../game/settings/Bindings.cs" Link="Linked/Bindings.cs" />
    <Compile Include="../../game/settings/UserSettings.cs" Link="Linked/UserSettings.cs" />
    <Compile Include="../../game/settings/PadSlots.cs" Link="Linked/PadSlots.cs" />
    <Compile Include="../../game/sound/Sfx.cs" Link="Linked/Sfx.cs" />
    <Compile Include="../../game/sound/Synth.cs" Link="Linked/Synth.cs" />
    <Compile Include="../../game/sound/WhiffWatch.cs" Link="Linked/WhiffWatch.cs" />
    <Compile Include="../../game/sound/SoundDirector.cs" Link="Linked/SoundDirector.cs" />
    <Compile Include="../../game/sound/MusicSynth.cs" Link="Linked/MusicSynth.cs" />
    <Compile Include="../../game/sound/MusicDirector.cs" Link="Linked/MusicDirector.cs" />
    <Compile Include="../../game/sound/Voice.cs" Link="Linked/Voice.cs" />
    <Compile Include="../../game/editor/MoveDocument.cs" Link="Linked/MoveDocument.cs" />
    <Compile Include="../../game/editor/ScriptWriter.cs" Link="Linked/ScriptWriter.cs" />
    <Compile Include="../../tools/MoveCompiler/*.cs" Exclude="../../tools/MoveCompiler/Program.cs" LinkBase="Linked/MoveCompiler" />
  </ItemGroup>

  <!-- The characters' moves, to check every notation they use reads as glyphs. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Sim/Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
