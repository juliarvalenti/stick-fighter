<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless perf benchmark for the simulation. Run in Release. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>StickFighter.Bench</RootNamespace>
    <AssemblyName>StickFighter.Bench</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sim/Sim.csproj" />
  </ItemGroup>
</Project>
