<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless replay runner: the determinism gate in CI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>StickFighter.ReplayRunner</RootNamespace>
    <AssemblyName>StickFighter.ReplayRunner</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sim/Sim.csproj" />
  </ItemGroup>
</Project>
